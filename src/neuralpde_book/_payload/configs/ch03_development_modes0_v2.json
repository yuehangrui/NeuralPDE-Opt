{
  "purpose": "chapter3_supervised_experiment_v1",
  "seed": 0,
  "dtype": "float32",
  "steps": 1500,
  "batch_size": 8,
  "eval_every": 250,
  "checkpoint_every": 250,
  "learning_rate": 0.001,
  "cpu_threads": 2,
  "objective": "relative_l2_squared",

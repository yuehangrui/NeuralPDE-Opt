        "branch_width": 128,
        "trunk_width": 128,
        "depth": 3,
        "hard_boundary": true,
        "coordinate_modes": 0
      }
    },
    {
      "name": "transformer",
      "kwargs": {
        "grid_size": 65,
        "sensor_stride": 4,
        "width": 64,
        "heads": 4,
        "layers": 2,
        "hard_boundary": true,
        "coordinate_modes": 0
      }
    }
  ]
}

{
  "name": "fno",
  "family": "FNO",
  "kwargs": {
    "modes": 12,
    "width": 32,
    "layers": 4,
    "hard_boundary": true
  },
  "training": {
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "scheduler": "plateau",
    "patience": 30,
    "factor": 0.5,
    "min_lr": 1e-06,
    "grad_clip": 1.0
  }
}
